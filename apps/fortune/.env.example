# HimatsudoFortune API (public/index.php) のオリジン。統合CMSハブから見ると別オリジンになるため、
# 開発時は HimatsudoFortune アプリのポート (composer serve が起動する localhost:8180) を、
# 本番はHimatsudoFortune自身のドメインを指定する。
VITE_API_BASE_URL=http://localhost:8180/api/admin

# Vite dev/preview サーバーへアクセスを許可する追加ホスト名（カンマ区切り）。
# IP アドレスと *.ts.net（Tailscale MagicDNS）はデフォルトで許可される。
VITE_ALLOWED_HOSTS=

# `vite preview` が /api/admin をプロキシする先。本番でアプリが特定のIPにしか
# バインドしていない場合のみ上書きする。
# 例: VITE_API_PROXY_TARGET=http://100.x.x.x:8180
