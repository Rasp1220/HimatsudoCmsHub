# Himatsudo API (public/index.php) のオリジン。統合CMSハブから見ると別オリジンになるため、
# 開発時は Himatsudo アプリのポート (bin/serve.php が起動する localhost:8080) を、
# 本番はHimatsudo自身のドメインを指定する。
VITE_API_BASE_URL=http://localhost:8080/admin/api

# 「プレビュー」ボタンが開く公開サイト側のプレビューページ URL。
# 未指定なら VITE_API_BASE_URL と同じオリジンの /preview を使うため、通常は不要。
# 公開サイトを API とは別のドメインで配信している場合のみ指定する。
# 例: VITE_PREVIEW_URL=https://example.com/preview
VITE_PREVIEW_URL=

# 管理画面から「統合CMSハブへ戻る」で開く、ハブ入口ページの URL。
# 未指定なら自動判定する（本番は同一オリジンの `/`、開発時の dev server:5174 は
# localhost:5173、自宅サーバの vite preview:4174 は同ホストの 4173）。
# ハブを別ドメインで運用している場合のみ指定する。
# 例: VITE_HUB_URL=https://admin.himatsudo.com/
VITE_HUB_URL=

# Vite dev/preview サーバーへアクセスを許可する追加ホスト名（カンマ区切り）。
# IP アドレスと *.ts.net（Tailscale MagicDNS）はデフォルトで許可される。
# 短い MagicDNS 名やカスタムホスト名で開く場合のみ指定する。
# 例: VITE_ALLOWED_HOSTS=my-machine,cms.example.com
VITE_ALLOWED_HOSTS=

# --- 本番公開（自宅サーバ + VPSリバースプロキシ方式）時のみ設定 ---
# HimatsudoCmsHub リポジトリの docs/deploy.md を参照。

# `npm run build` 時に埋め込まれる API のオリジン。CMS を公開サイトとは別の
# サブドメイン（例: cms.example.com）で公開する場合、アップロード画像 URL
# （/uploads/... のルート相対パス）の解決に使われるため、公開サイト側の
# ドメインを指定する。
# 例: VITE_API_BASE_URL=https://example.com/admin/api

# `vite preview` が /admin/api をプロキシする先。本番ではアプリ（PHP）が
# Tailscale IP にしかバインドしていないため、そのアドレスを指定する。
# 例: VITE_API_PROXY_TARGET=http://100.x.x.x:8080
